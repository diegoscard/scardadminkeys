generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ManagedDatabase {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  url       String   @unique @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  keys      LicenseKey[]

  @@map("managed_databases")
}

model LicenseKey {
  id           Int      @id @default(autoincrement())
  key          String   @unique @db.VarChar(255)
  status       String   @default("available") // available, activated, expired
  validityDays Int      @map("validity_days")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime? @map("expires_at")
  
  databaseId   Int?     @map("database_id")
  database     ManagedDatabase? @relation(fields: [databaseId], references: [id])
  shopName     String?  @db.VarChar(255) @map("shop_name")

  @@map("license_keys")
}
